nextflow_process {

    name "Test Process CROPHDF5"
    script "../main.nf"
    process "CROPHDF5"

    tag "modules"
    tag "modules_local"
    tag "crophdf5"

    test("crophdf5 - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'imaging/segmentation/cycif_tonsil_registered.ome.tif', checkIfExists: true),
                    2
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
