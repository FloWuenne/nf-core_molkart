nextflow_process {

    name "Test Process CROPTIFF"
    script "../main.nf"
    process "CROPTIFF"

    tag "modules"
    tag "modules_local"
    tag "croptiff"

    test("croptiff - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'imaging/segmentation/cycif_tonsil_registered.ome.tif', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'generic/txt/hello.txt', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
