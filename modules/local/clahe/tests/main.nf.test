nextflow_process {

    name "Test Process CLAHE"
    script "../main.nf"
    process "CLAHE"

    tag "modules"
    tag "modules_local"
    tag "clahe"

    test("clahe - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'imaging/segmentation/cycif_tonsil_registered.ome.tif', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
